# 本机演示默认配置
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
COOKIE_SECURE=0
TRUST_PROXY=0
SEED_DEMO=1
# DATA_DIR=./data

# 正式部署时由平台设置：NODE_ENV=production、SEED_DEMO=0。
# HTTPS 反向代理后设置：COOKIE_SECURE=1、TRUST_PROXY=1。
# 云端持久目录示例：DATA_DIR=/app/data

# 云游戏：默认直连厂商官方网页版，无需任何配置即可开玩。
# 只有自建 / 已获授权的服务才需要填写（仅 HTTPS，本机调试可用 http://localhost）。
# CLOUD_GENSHIN_URL=https://你的自建服务地址
# CLOUD_WUTHERING_WAVES_URL=
# CLOUD_STAR_RAIL_URL=
# CLOUD_ZZZ_URL=

# 仅当该自建服务允许被嵌入时可开启，游戏画面会在站内启动台直接运行。
# CLOUD_GENSHIN_EMBED=1
# 仅当该自建服务确实实现了单点登录时可开启；这只是状态标记，
# 不会自动实现 OAuth / SSO，也不能绕过厂商官方页面的游戏登录。
# CLOUD_GENSHIN_SSO=1
